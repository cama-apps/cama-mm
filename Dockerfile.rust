FROM debian:bookworm-slim AS runtime-base

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1001 appuser \
    && useradd --create-home --uid 1001 --gid 1001 --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/assets \
    && chown -R appuser:appuser /app

# The Release workflow resolves and verifies runtime data before invoking the
# image build. Docker packaging is deterministic and performs no dependency
# discovery of its own.
COPY --chown=appuser:appuser .cama-build/dotabase.db /app/assets/dotabase.db
COPY --chown=appuser:appuser .cama-build/dotabase.version /app/assets/dotabase.version
COPY --chown=appuser:appuser .cama-build/fonts/ /app/assets/fonts/
COPY --chown=appuser:appuser assets/pets/ /app/assets/pets/
COPY --chown=appuser:appuser assets/dig/ /app/assets/dig/
COPY --chown=root:root scripts/runtime-entrypoint /usr/local/bin/cama-runtime-entrypoint

WORKDIR /app

ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}
ENV BOT_RUNTIME=rust
LABEL org.opencontainers.image.revision=${GIT_SHA}

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD ["/usr/local/bin/cama-rust", "health-check", "--max-age-seconds", "90"]

ENTRYPOINT ["/usr/local/bin/cama-runtime-entrypoint", "rust", "/usr/local/bin/cama-rust"]

# CI compiles once with its persistent Cargo cache, then packages that exact
# artifact without rebuilding the workspace inside Docker.
FROM runtime-base AS runtime-prebuilt
COPY --chown=appuser:appuser .cama-build/cama-rust /usr/local/bin/cama-rust

FROM rust:1.94.0-bookworm AS builder

WORKDIR /build/rust

COPY .cama-build/fonts/ /app/assets/fonts/
COPY utils/heroes.json /build/utils/heroes.json
COPY rust/ ./
RUN cargo build --locked --release --package cama-runtime --bin cama-rust

FROM runtime-base AS runtime
COPY --from=builder --chown=appuser:appuser \
    /build/rust/target/release/cama-rust \
    /usr/local/bin/cama-rust
