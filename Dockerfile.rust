FROM python:3.12-slim AS dotabase-assets

WORKDIR /build
COPY --from=ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

FROM rust:1.94.0-bookworm AS builder

WORKDIR /build/rust

# Build the lift-and-shift Rust runtime in isolation. Compose continues to run
# Python until the machine-checked cutover gates prove this binary can own the
# gateway, migrations, workers, and shared database by itself.
COPY commands/ /build/commands/
COPY utils/heroes.json /build/utils/heroes.json
COPY rust/ ./
RUN cargo build --locked --release --package cama-runtime --bin cama-rust

FROM debian:bookworm-slim AS runtime

# Match the Python container's runtime UID and retain the shared font/SQLite
# runtime surface needed on the existing server.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        fonts-dejavu-core \
        libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1001 appuser \
    && useradd --create-home --uid 1001 --gid 1001 --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/assets \
    && chown -R appuser:appuser /app

COPY --from=builder --chown=appuser:appuser \
    /build/rust/target/release/cama-rust \
    /usr/local/bin/cama-rust
COPY --from=dotabase-assets --chown=appuser:appuser \
    /build/.venv/lib/python3.12/site-packages/dotabase/dotabase.db \
    /app/assets/dotabase.db
COPY --chown=appuser:appuser assets/pets/ /app/assets/pets/
COPY --chown=appuser:appuser assets/dig/ /app/assets/dig/
COPY --chown=root:root scripts/runtime-entrypoint /usr/local/bin/cama-runtime-entrypoint

WORKDIR /app

# Bake deploy metadata late so a new SHA does not invalidate build layers.
ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}
ENV BOT_RUNTIME=rust
LABEL org.opencontainers.image.revision=${GIT_SHA}

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD ["/usr/local/bin/cama-rust", "health-check", "--max-age-seconds", "90"]

ENTRYPOINT ["/usr/local/bin/cama-runtime-entrypoint", "rust", "/usr/local/bin/cama-rust"]
