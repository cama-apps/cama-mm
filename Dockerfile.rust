FROM python:3.12-slim AS dotabase-assets

WORKDIR /build
COPY --from=ghcr.io/astral-sh/uv:0.11.28@sha256:0f36cb9361a3346885ca3677e3767016687b5a170c1a6b88465ec14aefec90aa /uv /usr/local/bin/uv
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

# Retain the exact DejaVu files used by Python's shared font loader.  The
# manifest is checked against the locked Matplotlib wheel before the files
# cross into the minimal Rust image; a dependency/base-image drift fails the
# build instead of changing rendered glyph metrics silently.
COPY assets/fonts/dejavu.sha256 /build/dejavu.sha256
RUN set -eux; \
    mkdir -p /build/font-assets; \
    for font in \
        DejaVuSans.ttf \
        DejaVuSans-Bold.ttf \
        DejaVuSansMono.ttf \
        DejaVuSansMono-Bold.ttf; do \
        cp "/build/.venv/lib/python3.12/site-packages/matplotlib/mpl-data/fonts/ttf/$font" \
            "/build/font-assets/$font"; \
    done; \
    cp /build/.venv/lib/python3.12/site-packages/matplotlib/mpl-data/fonts/ttf/LICENSE_DEJAVU \
        /build/font-assets/LICENSE_DEJAVU; \
    cd /build/font-assets; \
    sha256sum -c /build/dejavu.sha256

FROM debian:bookworm-slim AS runtime-base

# Match the Python container's runtime UID and retain the shared font/SQLite
# runtime surface needed on the existing server.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        libsqlite3-0 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1001 appuser \
    && useradd --create-home --uid 1001 --gid 1001 --shell /usr/sbin/nologin appuser \
    && mkdir -p /app/assets \
    && chown -R appuser:appuser /app

COPY --from=dotabase-assets --chown=appuser:appuser \
    /build/.venv/lib/python3.12/site-packages/dotabase/dotabase.db \
    /app/assets/dotabase.db
COPY --from=dotabase-assets --chown=appuser:appuser \
    /build/font-assets/ /app/assets/fonts/
COPY --chown=appuser:appuser assets/pets/ /app/assets/pets/
COPY --chown=appuser:appuser assets/dig/ /app/assets/dig/
COPY --chown=root:root scripts/runtime-entrypoint /usr/local/bin/cama-runtime-entrypoint

WORKDIR /app

# Bake deploy metadata late so a new SHA does not invalidate build layers.
ARG GIT_SHA=unknown
ENV GIT_SHA=${GIT_SHA}
ENV BOT_RUNTIME=rust
LABEL org.opencontainers.image.revision=${GIT_SHA}

USER appuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=180s --retries=3 \
    CMD ["/usr/local/bin/cama-rust", "health-check", "--max-age-seconds", "90"]

ENTRYPOINT ["/usr/local/bin/cama-runtime-entrypoint", "rust", "/usr/local/bin/cama-rust"]

# CI compiles once with its persistent Cargo cache, then packages that exact
# artifact without rebuilding the workspace inside Docker. This target is also
# the immutable image published for production deployment.
FROM runtime-base AS runtime-prebuilt
COPY --chown=appuser:appuser .cama-build/cama-rust /usr/local/bin/cama-rust

FROM rust:1.94.0-bookworm AS builder

WORKDIR /build/rust

# Builder-run examples and tests must use the same verified fonts as the
# minimal runtime image; otherwise validation silently exercises the legacy
# bitmap fallback instead of production rendering.
COPY --from=dotabase-assets /build/font-assets/ /app/assets/fonts/

# Retain a self-contained local-build path for development and emergency
# deployment when an immutable CI image is unavailable.
COPY commands/ /build/commands/
COPY utils/heroes.json /build/utils/heroes.json
COPY rust/ ./
RUN cargo build --locked --release --package cama-runtime --bin cama-rust

FROM runtime-base AS runtime
COPY --from=builder --chown=appuser:appuser \
    /build/rust/target/release/cama-rust \
    /usr/local/bin/cama-rust
