        assert state["current"]["runtime"] == "rust"

        interrupted, interrupted_state = prepare_deploy_fixture(
            parent,
            "interrupted-pending-cutover-recovers",
            scenario="pending_recovery",
            initial_runtime="python",
            readiness_status="complete",
        )
        interrupted_timestamp = "20260814T120000Z"
