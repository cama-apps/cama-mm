        assert "recovered interrupted Rust deployment" in result.stderr
        assert state["current"]["runtime"] == "python"
        assert state["current"]["sha"] == "previous-python-sha"
        assert state["process_history"] == ["python", "cama-rust", "python"]
        assert not (interrupted / "data" / ".cama-rust-cutover").exists()
        assert_database_restored_before_retained_image(interrupted, state)

