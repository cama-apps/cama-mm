        backup_result = run_backup(interrupted_database, interrupted_backup)
        assert backup_result.returncode == 0, backup_result.stderr
        with sqlite3.connect(interrupted_database) as database:
            database.execute(
                "UPDATE players SET discord_username='interrupted-rust-write' WHERE discord_id=?",
                (REHEARSAL_PLAYER_ID,),
            )
            database.commit()
        interrupted_facts = json.loads(interrupted_state.read_text(encoding="utf-8"))
        interrupted_facts["backup_image"] = f"cama-mm-python-backup:{interrupted_timestamp}"
        interrupted_facts["backup_runs"] = 1
        interrupted_facts["backup"] = {
            "source": str(interrupted_database),
            "destination": str(interrupted_backup),
            "metadata": f"{interrupted_backup}.json",
        }
        interrupted_facts["tags"][f"cama-mm-bot-rollback:{interrupted_timestamp}"] = (
            "sha256:initial-python"
        )
        interrupted_facts["current"] = {
            "id": "interrupted-rust-container",
            "runtime": "rust",
            "sha": "interrupted-rust-sha",
            "image": "sha256:interrupted-rust",
            "running": True,
            "health": "starting",
            "uid": 1001,
            "data_mount": str(interrupted / "data"),
            "process": "cama-rust",
            "env": [
                "BOT_RUNTIME=rust",
                "GIT_SHA=interrupted-rust-sha",
                "DB_PATH=/app/data/cama_shuffle.db",
            ],
        }
        interrupted_facts["process_history"].append("cama-rust")
        interrupted_state.write_text(
            json.dumps(interrupted_facts, sort_keys=True), encoding="utf-8"
        )
        (interrupted / "data" / ".cama-rust-cutover").write_text(
            "\n".join(
                [
                    "state=pending",
                    "revision=interrupted-rust-sha",
                    f"backup={interrupted_backup}",
                    f"updated_at={interrupted_timestamp}",
                    "previous_runtime=python",
                    "previous_revision=previous-python-sha",
                    f"retained_image=cama-mm-bot-rollback:{interrupted_timestamp}",
                    f"backup_image=cama-mm-python-backup:{interrupted_timestamp}",
                    "",
                ]
            ),
            encoding="utf-8",
        )
