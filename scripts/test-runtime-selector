#!/usr/bin/env python3
"""Mechanical checks for the single-service Compose runtime selector."""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
import textwrap
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
COMPOSE = ROOT / "scripts" / "runtime-compose"
ENTRYPOINT = ROOT / "scripts" / "runtime-entrypoint"
DEPLOY = ROOT / "scripts" / "deploy-runtime"
MUTATING_DOCKER_OPERATIONS = (
    "build",
    "up",
    "start",
    "restart",
    "run",
    "create",
    "stop",
    "tag",
)


def rendered(runtime: str | None, candidate: str | None = None) -> dict[str, object]:
    env = os.environ.copy()
    env["GIT_SHA"] = "selector-test-sha"
    if runtime is None:
        env.pop("BOT_RUNTIME", None)
    else:
        env["BOT_RUNTIME"] = runtime
    if candidate is None:
        env.pop("RUST_CUTOVER_CANDIDATE", None)
    else:
        env["RUST_CUTOVER_CANDIDATE"] = candidate
    result = subprocess.run(
        [str(COMPOSE), "config", "--format", "json"],
        cwd=ROOT,
        env=env,
        check=True,
        capture_output=True,
        text=True,
    )
    return json.loads(result.stdout)


def shell_command(script: Path, *arguments: str) -> list[str]:
    if os.name != "nt":
        return [str(script), *arguments]
    shell = os.environ.get("CAMA_TEST_SH") or shutil.which("sh")
    if shell is None:
        raise RuntimeError("sh is required to exercise deployment scripts on Windows")
    return [shell, str(script), *arguments]


def copy_runtime_scripts(destination: Path) -> None:
    (destination / "scripts").mkdir(parents=True)
    for relative_path in (
        "scripts/deploy-runtime",
        "scripts/runtime-compose",
    ):
        source = ROOT / relative_path
        target = destination / relative_path
        shutil.copy2(source, target)


def write_fake_docker(bin_directory: Path) -> Path:
    docker = bin_directory / "docker"
    docker.write_text(
        textwrap.dedent(
            """\
            #!/bin/sh
            set -eu
            printf '%s\n' "$*" >>"$FAKE_DOCKER_LOG"

            if [ "$1" = compose ]; then
              for argument in "$@"; do
                [ "$argument" = ps ] && exit 0
                if [ "$argument" = config ]; then
                  printf '%s\n' cama-mm-bot
                  exit 0
                fi
              done
              exit 99
            fi

            if [ "$1" = ps ]; then
              printf '%s\n' foreign-cama-owner
              exit 0
            fi

            if [ "$1" = inspect ]; then
              [ "${FAKE_DOCKER_INSPECT_FAIL-}" = true ] && exit 66
              case "$*" in
                *Config.User*Config.Env*)
                  printf '%s\n' \
                    1001:1001 \
                    BOT_RUNTIME=python \
                    DB_PATH=/app/data/cama_shuffle.db
                  ;;
                *Config.Env*)
                  printf '%s\n' \
                    BOT_RUNTIME=python \
                    DB_PATH=/app/data/cama_shuffle.db
                  ;;
                *Config.User*) printf '%s\n' 1001:1001 ;;
              esac
              exit 0
            fi

            exit 0
            """
        ),
        encoding="utf-8",
        newline="\n",
    )
    docker.chmod(0o755)
    python3 = bin_directory / "python3"
    python3.write_text("#!/bin/sh\nexit 0\n", encoding="utf-8", newline="\n")
    python3.chmod(0o755)
    return docker


def assert_no_runtime_mutation(invocations: list[str]) -> None:
    assert not any(
        f" {operation} " in f" {invocation} "
        for invocation in invocations
        for operation in MUTATING_DOCKER_OPERATIONS
    ), invocations


def assert_runtime_ownership() -> None:
    with tempfile.TemporaryDirectory(prefix="cama-runtime-owner-") as raw_directory:
        temporary_root = Path(raw_directory)
        checkout = temporary_root / "checkout"
        copy_runtime_scripts(checkout)
        bin_directory = temporary_root / "bin"
        bin_directory.mkdir()
        write_fake_docker(bin_directory)
        log_path = temporary_root / "docker.log"
        environment = os.environ.copy()
        environment["PATH"] = os.pathsep.join(
            [str(bin_directory), environment.get("PATH", "")]
        )
        environment["FAKE_DOCKER_LOG"] = str(log_path)

        for runtime in ("python", "rust"):
            result = subprocess.run(
                shell_command(
                    checkout / "scripts" / "runtime-compose", "ps", "--quiet", "bot"
                ),
                cwd=checkout,
                env=environment | {"BOT_RUNTIME": runtime},
                capture_output=True,
                text=True,
            )
            assert result.returncode == 0, result.stderr
        invocations = log_path.read_text(encoding="utf-8").splitlines()
        assert invocations == [
            "compose --project-name cama-mm --file docker-compose.yml ps --quiet bot",
            "compose --project-name cama-mm --file docker-compose.yml "
            "--file docker-compose.rust.yml ps --quiet bot",
        ], invocations

        log_path.write_text("", encoding="utf-8")
        deploy_environment = environment | {
            "BOT_RUNTIME": "python",
            "DEPLOY_HEALTH_TIMEOUT_SECONDS": "1",
            "GIT_SHA": "ownership-test-sha",
        }
        result = subprocess.run(
            shell_command(checkout / "scripts" / "deploy-runtime"),
            cwd=checkout,
            env=deploy_environment,
            capture_output=True,
            text=True,
        )
        assert result.returncode == 65, (result.returncode, result.stderr)
        assert "another Cama bot runtime is already running" in result.stderr, result.stderr
        invocations = log_path.read_text(encoding="utf-8").splitlines()
        assert (
            "ps --no-trunc --filter status=running "
            "--filter label=com.docker.compose.service=bot --quiet"
        ) in invocations, invocations
        assert_no_runtime_mutation(invocations)

        log_path.write_text("", encoding="utf-8")
        result = subprocess.run(
            shell_command(checkout / "scripts" / "deploy-runtime"),
            cwd=checkout,
            env=deploy_environment | {"FAKE_DOCKER_INSPECT_FAIL": "true"},
            capture_output=True,
            text=True,
        )
        invocations = log_path.read_text(encoding="utf-8").splitlines()
        assert_no_runtime_mutation(invocations)
        assert result.returncode == 65, (result.returncode, result.stderr)
        assert "runtime ownership could not be inspected" in result.stderr, result.stderr

        recovery_timestamp = "20260816T120000Z"
        if os.name == "nt":
            shell = os.environ.get("CAMA_TEST_SH") or shutil.which("sh")
            assert shell is not None
            shell_root_result = subprocess.run(
                [shell, "-c", 'CDPATH= cd -- "$1" && pwd', "sh", str(checkout)],
                check=True,
                capture_output=True,
                text=True,
            )
            shell_root = shell_root_result.stdout.strip()
        else:
            shell_root = str(checkout.resolve())
        marker = checkout / "data" / ".cama-rust-cutover"
        marker.parent.mkdir(parents=True, exist_ok=True)
        marker.write_text(
            "\n".join(
                (
                    "state=pending",
                    "revision=candidate-sha",
                    f"backup={shell_root}/data/backups/predeploy-{recovery_timestamp}.db",
                    f"updated_at={recovery_timestamp}",
                    "backup_ready=false",
                    "previous_runtime=python",
                    "previous_revision=previous-sha",
                    f"retained_image=cama-mm-bot-rollback:{recovery_timestamp}",
                    f"backup_image=cama-mm-python-backup:{recovery_timestamp}",
                    "",
                )
            ),
            encoding="utf-8",
            newline="\n",
        )
        log_path.write_text("", encoding="utf-8")
        result = subprocess.run(
            shell_command(checkout / "scripts" / "deploy-runtime"),
            cwd=checkout,
            env=deploy_environment,
            capture_output=True,
            text=True,
        )
        invocations = log_path.read_text(encoding="utf-8").splitlines()
        assert_no_runtime_mutation(invocations)
        assert result.returncode == 65, (result.returncode, result.stderr)
        assert "another Cama bot runtime is already running" in result.stderr, result.stderr


def assert_selector() -> None:
    default = rendered(None)
    python = rendered("python")
    rust = rendered("rust")

    assert set(default["services"]) == {"bot"}
    assert set(python["services"]) == {"bot"}
    assert set(rust["services"]) == {"bot"}

    default_bot = default["services"]["bot"]
    python_bot = python["services"]["bot"]
    rust_bot = rust["services"]["bot"]
    assert default_bot == python_bot
    assert python_bot["build"]["dockerfile"] == "Dockerfile"
    assert rust_bot["build"]["dockerfile"] == "Dockerfile.rust"
    assert python_bot["build"]["args"]["GIT_SHA"] == "selector-test-sha"
    assert rust_bot["build"]["args"]["GIT_SHA"] == "selector-test-sha"
    assert python_bot["environment"]["BOT_RUNTIME"] == "python"
    assert rust_bot["environment"]["BOT_RUNTIME"] == "rust"
    assert "RUST_CUTOVER_CANDIDATE" not in python_bot["environment"]
    assert rust_bot["environment"]["RUST_CUTOVER_CANDIDATE"] == "false"
    assert rust_bot["command"] == ["serve"]
    assert python_bot["user"] == rust_bot["user"] == "1001:1001"
    assert python_bot["restart"] == rust_bot["restart"] == "always"
    assert python_bot["environment"]["DB_PATH"] == "/app/data/cama_shuffle.db"
    assert rust_bot["environment"]["DB_PATH"] == "/app/data/cama_shuffle.db"
    assert python_bot["volumes"] == rust_bot["volumes"]

    # The selector replaces only the implementation behind the existing bot
    # service. Keep this as an exact rendered-service comparison so a future
    # edit cannot silently drift mounts, credentials, UID, capabilities,
    # restart policy, TTY, or network identity on just one runtime.
    expected_rust_bot = json.loads(json.dumps(python_bot))
    expected_rust_bot["build"]["dockerfile"] = "Dockerfile.rust"
    expected_rust_bot["environment"]["BOT_RUNTIME"] = "rust"
    expected_rust_bot["environment"]["RUST_CUTOVER_CANDIDATE"] = "false"
    expected_rust_bot["command"] = ["serve"]
    assert rust_bot == expected_rust_bot

    # Compose forwards the exact operator value. RuntimeConfig accepts only
    # lowercase `true`; case-mismatched values must remain visibly disabled
    # rather than being normalized by the selector.
    assert (
        rendered("rust", "true")["services"]["bot"]["environment"]["RUST_CUTOVER_CANDIDATE"]
        == "true"
    )
    assert (
        rendered("rust", "TRUE")["services"]["bot"]["environment"]["RUST_CUTOVER_CANDIDATE"]
        == "TRUE"
    )

    for invalid in ("", "bogus", "RUST"):
        env = os.environ | {"BOT_RUNTIME": invalid}
        result = subprocess.run(
            [str(COMPOSE), "config", "--quiet"],
            cwd=ROOT,
            env=env,
            capture_output=True,
            text=True,
        )
        assert result.returncode != 0, invalid

    for image_runtime in ("python", "rust"):
        good = subprocess.run(
            [str(ENTRYPOINT), image_runtime, "true"],
            env=os.environ | {"BOT_RUNTIME": image_runtime},
        )
        assert good.returncode == 0
        other = "rust" if image_runtime == "python" else "python"
        mismatch = subprocess.run(
            [str(ENTRYPOINT), image_runtime, "true"],
            env=os.environ | {"BOT_RUNTIME": other},
            capture_output=True,
            text=True,
        )
        assert mismatch.returncode == 64

        for invalid in (None, "", "bogus", "RUST"):
            entrypoint_env = os.environ.copy()
            if invalid is None:
                entrypoint_env.pop("BOT_RUNTIME", None)
            else:
                entrypoint_env["BOT_RUNTIME"] = invalid
            rejected = subprocess.run(
                [str(ENTRYPOINT), image_runtime, "true"],
                env=entrypoint_env,
                capture_output=True,
                text=True,
            )
            assert rejected.returncode == 64, (image_runtime, invalid)

    with tempfile.TemporaryDirectory(prefix="cama-one-way-selector-") as raw_directory:
        database_directory = Path(raw_directory)
        database_path = database_directory / "cama_shuffle.db"
        marker = database_directory / ".cama-rust-cutover"
        marker.write_text("state=active\n", encoding="utf-8")
        blocked_python = subprocess.run(
            [str(ENTRYPOINT), "python", "true"],
            env=os.environ
            | {
                "BOT_RUNTIME": "python",
                "DB_PATH": str(database_path),
            },
            capture_output=True,
            text=True,
        )
        assert blocked_python.returncode == 65
        assert "one-way Rust cutover started" in blocked_python.stderr
        marker.write_text(
            "state=recovering\nprevious_runtime=python\nprevious_revision=recovered-python-sha\n",
            encoding="utf-8",
        )
        recovering_python = subprocess.run(
            [str(ENTRYPOINT), "python", "true"],
            env=os.environ
            | {
                "BOT_RUNTIME": "python",
                "GIT_SHA": "recovered-python-sha",
                "DB_PATH": str(database_path),
                "CAMA_DEPLOY_RECOVERY": "true",
            },
            capture_output=True,
            text=True,
        )
        assert recovering_python.returncode == 0
        mismatched_recovery = subprocess.run(
            [str(ENTRYPOINT), "python", "true"],
            env=os.environ
            | {
                "BOT_RUNTIME": "python",
                "GIT_SHA": "different-python-sha",
                "DB_PATH": str(database_path),
                "CAMA_DEPLOY_RECOVERY": "true",
            },
            capture_output=True,
            text=True,
        )
        assert mismatched_recovery.returncode == 65
        marker.write_text(
            "state=pending\nprevious_runtime=python\nprevious_revision=recovered-python-sha\n",
            encoding="utf-8",
        )
        pending_python = subprocess.run(
            [str(ENTRYPOINT), "python", "true"],
            env=os.environ
            | {
                "BOT_RUNTIME": "python",
                "GIT_SHA": "recovered-python-sha",
                "DB_PATH": str(database_path),
            },
            capture_output=True,
            text=True,
        )
        assert pending_python.returncode == 65
        marker.write_text("state=active\n", encoding="utf-8")
        allowed_rust = subprocess.run(
            [str(ENTRYPOINT), "rust", "true"],
            env=os.environ | {"BOT_RUNTIME": "rust", "DB_PATH": str(database_path)},
        )
        assert allowed_rust.returncode == 0

    deploy_env = os.environ | {"BOT_RUNTIME": "rust"}
    deploy_env.pop("RUST_CUTOVER_CANDIDATE", None)
    ungated_deploy = subprocess.run(
        [str(DEPLOY)],
        cwd=ROOT,
        env=deploy_env,
        capture_output=True,
        text=True,
    )
    assert ungated_deploy.returncode == 65
    assert "complete parity gate" in ungated_deploy.stderr


if __name__ == "__main__":
    try:
        if sys.argv[1:] == ["--ownership-only"]:
            assert_runtime_ownership()
        elif sys.argv[1:]:
            raise RuntimeError("expected no arguments or --ownership-only")
        else:
            assert_selector()
            assert_runtime_ownership()
    except (
        AssertionError,
        KeyError,
        OSError,
        RuntimeError,
        subprocess.SubprocessError,
    ) as error:
        print(f"runtime selector validation failed: {error}", file=sys.stderr)
        raise SystemExit(1) from error
    if sys.argv[1:]:
        print("runtime ownership validation passed (stable project, single owner)")
    else:
        print(
            "runtime selector validation passed "
            "(default=python, opt-in=rust, invalid=closed, single-owner enforced)"
        )
