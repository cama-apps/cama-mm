#!/bin/sh
set -eu

expected_runtime=$1
shift

case "${BOT_RUNTIME-}" in
  python|rust)
    ;;
  "")
    echo "BOT_RUNTIME must be explicitly resolved to python or rust" >&2
    exit 64
    ;;
  *)
    echo "invalid BOT_RUNTIME=${BOT_RUNTIME}; expected python or rust" >&2
    exit 64
    ;;
esac

if [ "$BOT_RUNTIME" != "$expected_runtime" ]; then
  echo "BOT_RUNTIME=$BOT_RUNTIME does not match the $expected_runtime runtime image" >&2
  exit 64
fi

if [ "$expected_runtime" = python ]; then
  database_path=${DB_PATH:-/app/data/cama_shuffle.db}
  database_directory=$(dirname -- "$database_path")
  cutover_marker="$database_directory/.cama-rust-cutover"
  if [ -e "$cutover_marker" ]; then
    marker_state=$(awk -F= '$1 == "state" { print substr($0, 7); exit }' "$cutover_marker")
    previous_runtime=$(
      awk -F= '$1 == "previous_runtime" { print substr($0, 18); exit }' "$cutover_marker"
    )
    previous_revision=$(
      awk -F= '$1 == "previous_revision" { print substr($0, 19); exit }' "$cutover_marker"
    )
    if [ "$marker_state:$previous_runtime:$previous_revision" != \
      "recovering:python:${GIT_SHA-}" ]
    then
      echo "Python runtime refused: $cutover_marker proves the one-way Rust cutover started" >&2
      exit 65
    fi
  fi
fi

exec "$@"
