#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repository_root"

case "${BOT_RUNTIME-rust}" in
  rust) ;;
  "") echo "BOT_RUNTIME is empty; only rust is supported" >&2; exit 64 ;;
  *) echo "BOT_RUNTIME=${BOT_RUNTIME} is unsupported; runtime is Rust-only" >&2; exit 64 ;;
esac

export BOT_RUNTIME=rust
exec docker compose \
  --project-name cama-mm \
  --file docker-compose.yml \
  "$@"
