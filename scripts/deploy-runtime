#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
runtime_compose="$repository_root/scripts/runtime-compose"
post_deploy_verify="$repository_root/scripts/post-deploy-verify"
database_dir="$repository_root/data"
database_path="$database_dir/cama_shuffle.db"
backup_dir="$database_dir/backups"
deploy_lock="$database_dir/.cama-deploy.lock"
deploy_lock_owned=false

case "${BOT_RUNTIME-rust}" in
  rust) ;;
  "") echo "BOT_RUNTIME is empty; only rust is supported" >&2; exit 64 ;;
  *) echo "BOT_RUNTIME=${BOT_RUNTIME} is unsupported; deployment is Rust-only" >&2; exit 64 ;;
esac
export BOT_RUNTIME=rust

deploy_sha=${GIT_SHA-}
if [ -z "$deploy_sha" ]; then
  deploy_sha=$(git -C "$repository_root" rev-parse --verify HEAD)
fi
runtime_image=${RUST_RUNTIME_IMAGE-}
if [ -z "$runtime_image" ]; then
  echo "RUST_RUNTIME_IMAGE must name the immutable image to deploy" >&2
  exit 64
fi
health_timeout=${DEPLOY_HEALTH_TIMEOUT_SECONDS:-300}
case "$health_timeout" in
  *[!0-9]*|"") echo "DEPLOY_HEALTH_TIMEOUT_SECONDS must be a positive integer" >&2; exit 64 ;;
esac
[ "$health_timeout" -gt 0 ] || {
  echo "DEPLOY_HEALTH_TIMEOUT_SECONDS must be a positive integer" >&2
  exit 64
}

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p "$database_dir" "$backup_dir"
if ! mkdir "$deploy_lock" 2>/dev/null; then
  echo "another deployment owns $deploy_lock" >&2
  exit 73
fi
deploy_lock_owned=true
printf '%s\n' "$$" >"$deploy_lock/pid"
cleanup() {
  if [ "$deploy_lock_owned" = true ]; then
    rm -f -- "$deploy_lock/pid"
    rmdir "$deploy_lock" 2>/dev/null || true
  fi
}
trap cleanup EXIT HUP INT TERM

container_env_value() {
  docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$1" \
    | awk -v key="$2" 'index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }'
}

resolve_container() {
  container_ids=$("$runtime_compose" ps --quiet bot)
  set -- $container_ids
  case "$#" in
    0) return 0 ;;
    1) printf '%s\n' "$1" ;;
    *) echo "expected at most one managed bot container, found $#" >&2; return 1 ;;
  esac
}

stop_container() {
  container_id=$1
  docker stop "$container_id" >/dev/null
  running=$(docker inspect --format '{{.State.Running}}' "$container_id" 2>/dev/null || true)
  [ "$running" = false ] || {
    echo "container $container_id did not stop" >&2
    return 1
  }
}

wait_for_runtime() {
  container_id=$1
  expected_sha=$2
  deadline=$(( $(date +%s) + health_timeout ))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    running=$(docker inspect --format '{{.State.Running}}' "$container_id" 2>/dev/null || true)
    health=$(docker inspect --format \
      '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
      "$container_id" 2>/dev/null || true)
    actual_runtime=$(container_env_value "$container_id" BOT_RUNTIME 2>/dev/null || true)
    actual_sha=$(container_env_value "$container_id" GIT_SHA 2>/dev/null || true)
    if [ "$running" = true ] && [ "$health" = healthy ] \
      && [ "$actual_runtime" = rust ] && [ "$actual_sha" = "$expected_sha" ]
    then
      return 0
    fi
    [ "$health" != unhealthy ] || return 1
    sleep 5
  done
  return 1
}

copy_sqlite_set() {
  source_path=$1
  destination_path=$2
  cp -p "$source_path" "$destination_path"
  for suffix in -wal -shm; do
    if [ -f "$source_path$suffix" ]; then
      cp -p "$source_path$suffix" "$destination_path$suffix"
    fi
  done
}

restore_sqlite_set() {
  source_path=$1
  destination_path=$2
  rm -f -- "$destination_path" "$destination_path-wal" "$destination_path-shm"
  copy_sqlite_set "$source_path" "$destination_path"
}

cd "$repository_root"
current_container=$(resolve_container)
previous_image=
previous_sha=
if [ -n "$current_container" ]; then
  previous_runtime=$(container_env_value "$current_container" BOT_RUNTIME)
  [ "$previous_runtime" = rust ] || {
    echo "current bot is not Rust; automatic legacy-runtime rollback is unsupported" >&2
    exit 65
  }
  previous_sha=$(container_env_value "$current_container" GIT_SHA)
  previous_image=$(docker inspect --format '{{.Image}}' "$current_container")
fi

docker pull "$runtime_image"
image_revision=$(docker image inspect \
  --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' \
  "$runtime_image" 2>/dev/null || true)
[ "$image_revision" = "$deploy_sha" ] || {
  echo "runtime image revision mismatch: expected $deploy_sha, found ${image_revision:-missing}" >&2
  exit 65
}

target_images=$("$runtime_compose" config --images)
set -- $target_images
[ "$#" -eq 1 ] || {
  echo "expected exactly one runtime image target, found $#" >&2
  exit 65
}
target_image=$1
rollback_tag=
if [ -n "$previous_image" ]; then
  rollback_tag="cama-mm-bot-rollback:$timestamp"
  docker tag "$previous_image" "$rollback_tag"
fi
docker tag "$runtime_image" "$target_image"

if [ ! -s "$database_path" ]; then
  echo "deployment refused: $database_path is missing or empty" >&2
  exit 65
fi
if [ -n "$current_container" ]; then
  stop_container "$current_container"
fi

backup_path="$backup_dir/predeploy-$timestamp.db"
if ! copy_sqlite_set "$database_path" "$backup_path"; then
  echo "predeploy database backup failed" >&2
  if [ -n "$rollback_tag" ]; then
    docker tag "$rollback_tag" "$target_image"
    GIT_SHA="$previous_sha" "$runtime_compose" \
      up --detach --no-build --force-recreate --no-deps bot
  fi
  exit 1
fi
[ -s "$backup_path" ] || {
  echo "predeploy database backup is empty" >&2
  exit 1
}

preflight_path="$backup_dir/rust-preflight-$timestamp.db"
copy_sqlite_set "$backup_path" "$preflight_path"
if ! GIT_SHA="$deploy_sha" "$runtime_compose" run --rm --no-deps bot \
  db-admit \
  --db-path "/app/data/backups/rust-preflight-$timestamp.db" \
  --source-db /app/data/cama_shuffle.db \
  --disposable-copy
then
  echo "Rust schema admission failed before startup" >&2
  restore_sqlite_set "$backup_path" "$database_path"
  if [ -n "$rollback_tag" ]; then
    docker tag "$rollback_tag" "$target_image"
    GIT_SHA="$previous_sha" "$runtime_compose" up --detach --no-build --force-recreate --no-deps bot
  fi
  exit 1
fi
rm -f -- "$preflight_path" "$preflight_path-wal" "$preflight_path-shm"

deployment_healthy=true
if ! GIT_SHA="$deploy_sha" "$runtime_compose" \
  up --detach --no-build --force-recreate --no-deps bot
then
  deployment_healthy=false
fi
new_container=$(resolve_container)
if [ -z "$new_container" ] || ! wait_for_runtime "$new_container" "$deploy_sha" \
  || ! GIT_SHA="$deploy_sha" "$post_deploy_verify"
then
  deployment_healthy=false
fi

if [ "$deployment_healthy" != true ]; then
  echo "Rust deployment failed verification; restoring the stopped runtime" >&2
  if [ -n "$new_container" ]; then
    stop_container "$new_container" || true
  fi
  restore_sqlite_set "$backup_path" "$database_path"
  if [ -z "$rollback_tag" ]; then
    echo "no previous image exists; rollback cannot restart a runtime" >&2
    exit 1
  fi
  docker tag "$rollback_tag" "$target_image"
  GIT_SHA="$previous_sha" "$runtime_compose" \
    up --detach --no-build --force-recreate --no-deps bot
  rollback_container=$(resolve_container)
  if [ -z "$rollback_container" ] || ! wait_for_runtime "$rollback_container" "$previous_sha"; then
    echo "rollback failed closed" >&2
    exit 1
  fi
  echo "rollback restored database=$backup_path image=$rollback_tag" >&2
  exit 1
fi

echo "deployed BOT_RUNTIME=rust GIT_SHA=$deploy_sha"
echo "verified backup: $backup_path"
if [ -n "$rollback_tag" ]; then
  echo "retained rollback image: $rollback_tag"
fi
